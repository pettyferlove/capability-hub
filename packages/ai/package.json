{
  "name": "@capability-hub/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build/clean-package.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mastra/core": "catalog:",
    "@mastra/memory": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/anthropic": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./records": {
      "development": "./src/records.ts",
      "types": "./dist/records.d.ts",
      "default": "./dist/records.js"
    },
    "./ports": {
      "development": "./src/ports.ts",
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./mastra": {
      "development": "./src/mastra.ts",
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./storage": {
      "development": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
