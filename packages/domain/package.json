    "./content": {
      "development": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./token": {
      "development": "./src/token.ts",
      "types": "./dist/token.d.ts",
      "default": "./dist/token.js"
    },
    "./identity": {
      "development": "./src/identity.ts",
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./policy": {
      "development": "./src/policy.ts",
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./audit": {
      "development": "./src/audit.ts",
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./version-labels": {
      "development": "./src/version-labels.ts",
      "types": "./dist/version-labels.d.ts",
      "default": "./dist/version-labels.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
