{
  "name": "@capability-hub/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build/clean-package.mjs && tsc -p tsconfig.build.json && node ../../scripts/build/copy-runtime-assets.mjs"
  },
  "dependencies": {
    "@capability-hub/contracts": "workspace:*",
    "@capability-hub/domain": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "0.45.4",
    "minio": "catalog:",
    "pg": "catalog:",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "@capability-hub/application": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "typescript": "catalog:",
    "tsx": "catalog:"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "development": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./store": {
      "development": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./git": {
      "development": "./src/git/git-repository.ts",
      "types": "./dist/git/git-repository.d.ts",
      "default": "./dist/git/git-repository.js"
    },
    "./scanning": {
      "development": "./src/scanning/scanner.ts",
      "types": "./dist/scanning/scanner.d.ts",
      "default": "./dist/scanning/scanner.js"
    },
    "./security": {
      "development": "./src/security/index.ts",
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
