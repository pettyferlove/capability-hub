{
  "name": "@capability-hub/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build/clean-package.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "development": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./web-pages": {
      "development": "./src/web-pages.ts",
      "types": "./dist/web-pages.d.ts",
      "default": "./dist/web-pages.js"
    },
    "./schemas/mcp-server.schema.json": "./schemas/mcp-server.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "src"
  ]
}
