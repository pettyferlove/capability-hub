{
  "name": "@capability-hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build/clean-package.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@capability-hub/infrastructure": "workspace:*",
    "@capability-hub/contracts": "workspace:*",
    "@capability-hub/domain": "workspace:*",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "express": "catalog:",
    "multer": "^2.0.2",
    "zod": "catalog:",
    "@capability-hub/logging": "workspace:*",
    "@capability-hub/application": "workspace:*",
    "bowser": "^2.15.0",
    "@capability-hub/ai": "workspace:*",
    "@capability-hub/hub-agents": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  },
  "exports": {
    ".": {
      "development": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config": {
      "development": "./src/config/server-config.ts",
      "types": "./dist/config/server-config.d.ts",
      "default": "./dist/config/server-config.js"
    },
    "./storage": {
      "development": "./src/bootstrap/storage.ts",
      "types": "./dist/bootstrap/storage.d.ts",
      "default": "./dist/bootstrap/storage.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
