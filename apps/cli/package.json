{
  "name": "@capability-hub/cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && node ../../scripts/build/clean-package.mjs && node ../../scripts/build/bundle-cli.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@capability-hub/contracts": "workspace:*",
    "@capability-hub/domain": "workspace:*",
    "@capability-hub/infrastructure": "workspace:*",
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "15.0.0",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "zod": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./run": {
      "development": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./run": "./dist/main.js"
    }
  },
  "bin": {
    "capability-hub": "./bin/capability-hub.mjs"
  },
  "files": [
    "dist",
    "bin"
  ]
}
