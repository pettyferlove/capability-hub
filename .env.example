# pnpm dev/start and root operation commands read .env; frontend bundles contain none of these values.
CAPABILITY_HUB_HOST=127.0.0.1
PORT=4100
CAPABILITY_HUB_PUBLIC_URL=http://127.0.0.1:4100
CAPABILITY_HUB_DATA_DIR=.data
# CAPABILITY_HUB_WEB_DIR=apps/web/dist
CAPABILITY_HUB_GIT_HOSTS=github.com,gitlab.com
CAPABILITY_HUB_PRIVATE_GIT_HOSTS=
CAPABILITY_HUB_WORKER=1

# JSON stdout, levels: trace/debug/info/warn/error/fatal/silent. Browser events use the same sink.
CAPABILITY_HUB_LOG_LEVEL=info
CAPABILITY_HUB_REQUEST_LOGS=1
# Production requires HTTPS, a unique setup token, and a shared 64-character hexadecimal instance secret.
# CAPABILITY_HUB_INSTANCE_SECRET=
# CAPABILITY_HUB_SETUP_TOKEN=

# Select explicitly: sqlite | postgresql. No automatic failover or data conversion.
CAPABILITY_HUB_DATABASE_DRIVER=sqlite
# CAPABILITY_HUB_DATABASE_URL=postgresql://capability_hub:PASSWORD@127.0.0.1:15432/capability_hub
CAPABILITY_HUB_DATABASE_POOL_SIZE=10

# Select explicitly: filesystem | minio. MinIO bucket must already exist and be private.
CAPABILITY_HUB_OBJECT_STORAGE_DRIVER=filesystem
# CAPABILITY_HUB_MINIO_ENDPOINT=http://127.0.0.1:19000
# CAPABILITY_HUB_MINIO_ACCESS_KEY=
# CAPABILITY_HUB_MINIO_SECRET_KEY=
CAPABILITY_HUB_MINIO_BUCKET=capability-hub
CAPABILITY_HUB_MINIO_REGION=us-east-1
CAPABILITY_HUB_MINIO_PREFIX=blobs/

# Compose-only settings. Replace image examples with reviewed versioned tags/digests before running.
# CAPABILITY_HUB_IMAGE=registry.example.com/capability-hub:VERSION
# CAPABILITY_HUB_POSTGRES_IMAGE=postgres:17.11-trixie
# Select an approved MinIO image explicitly for production; tests use a separate isolated fixture image.
# CAPABILITY_HUB_MINIO_IMAGE=YOUR_APPROVED_IMAGE
# Generate URL-safe database passwords, e.g. openssl rand -hex 24.
# CAPABILITY_HUB_POSTGRES_PASSWORD=
# CAPABILITY_HUB_MINIO_ROOT_USER=
# CAPABILITY_HUB_MINIO_ROOT_PASSWORD=
# CAPABILITY_HUB_BIND_HOST=127.0.0.1
# CAPABILITY_HUB_PORT=4100
# CAPABILITY_HUB_POSTGRES_PORT=15432
# CAPABILITY_HUB_MINIO_PORT=19000
# CAPABILITY_HUB_MINIO_CONSOLE_PORT=19001
