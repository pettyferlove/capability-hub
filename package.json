{
  "name": "capability-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "node scripts/setup/require-pnpm.mjs",
    "dev": "pnpm --filter @capability-hub/server dev",
    "dev:web": "pnpm --filter @capability-hub/web dev",
    "start": "pnpm --filter @capability-hub/server start",
    "cli": "node --conditions=development --import tsx bin/capability-hub.mjs",
    "typecheck": "pnpm -r --sort typecheck && tsc --noEmit -p tsconfig.json",
    "check:architecture": "node --conditions=development --import tsx scripts/checks/check-architecture.ts",
    "build": "pnpm typecheck && pnpm -r --sort build && tsc -p tsconfig.operations.json",
    "test": "node scripts/testing/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm check:architecture && pnpm check:documentation && pnpm db:check && pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "backup": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/backup.ts",
    "restore:check": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/restore-check.ts",
    "account:recover": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/recover-account.ts",
    "maintenance": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/maintenance.ts",
    "restore:import": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/restore-import.ts",
    "test:external": "node scripts/testing/test-external.mjs",
    "lint": "eslint apps packages scripts bin tests",
    "test:image": "node scripts/testing/verify-image.mjs",
    "check:documentation": "node --conditions=development --import tsx scripts/checks/check-documentation.mjs",
    "db:generate:sqlite": "drizzle-kit generate --config=scripts/database/drizzle-sqlite.ts",
    "db:generate:postgresql": "drizzle-kit generate --config=scripts/database/drizzle-postgresql.ts",
    "db:generate": "pnpm db:generate:sqlite && pnpm db:generate:postgresql",
    "db:check": "node --conditions=development --import tsx scripts/checks/check-database.mjs",
    "db:migrate": "node --conditions=development --env-file-if-exists=.env --import tsx scripts/operations/migrate.ts",
    "test:ai:live": "node --conditions=development --env-file-if-exists=.env --import ./scripts/testing/register-test-runtime.mjs --test tests/live/ai-models.test.ts"
  },
  "devDependencies": {
    "@capability-hub/ai": "workspace:*",
    "@capability-hub/application": "workspace:*",
    "@capability-hub/cli": "workspace:*",
    "@capability-hub/contracts": "workspace:*",
    "@capability-hub/domain": "workspace:*",
    "@capability-hub/hub-agents": "workspace:*",
    "@capability-hub/infrastructure": "workspace:*",
    "@capability-hub/logging": "workspace:*",
    "@capability-hub/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "express": "catalog:",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "minio": "catalog:",
    "pg": "catalog:",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "supertest": "^7.1.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "zod": "catalog:"
  },
  "bin": {
    "capability-hub": "bin/capability-hub.mjs"
  }
}
