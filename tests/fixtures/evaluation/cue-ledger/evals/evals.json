{
  "evals": [
    {
      "prompt": "把彩排时段 A|0|10、A|5|15、B|2|5、A|20|21、C|0|2 汇成分幕实际占用秒数清单。",
      "expected_output": "A|16\nB|3\nC|2",
      "assertions": [
        "第一行是 A|16。",
        "第二行是 B|3。",
        "第三行是 C|2。",
        "清单正好包含三行分幕结果。"
      ]
    },
    {
      "prompt": "排练表中有 C|10|20、A|0|2、C|10|20、C|12|16、B|1|8。请交付分幕实际占用清单。",
      "expected_output": "A|2\nB|7\nC|10",
      "assertions": [
        "第一行是 A|2。",
        "第二行是 B|7。",
        "第三行是 C|10。",
        "清单正好包含三行分幕结果。"
      ]
    },
    {
      "prompt": "核对 A|0|3、A|3|8、B|0|9、B|2|3 的实际占用秒数，交付分幕清单。",
      "expected_output": "A|8\nB|9",
      "assertions": ["第一行是 A|8。", "第二行是 B|9。", "清单正好包含两行分幕结果。"]
    }
  ]
}
